# Evaluate route safety based on AI predictions
def calculate_safety_score(route_data):
    total_risk = 0
    for leg in route_data['routes'][0]['legs']:
        for step in leg['steps']:
            lat, lon = step['start_location']['lat'], step['start_location']['lng']
            predicted_severity = model.predict([[lat, lon]])[0]
            total_risk += predicted_severity
    return 100 - (total_risk / len(route_data['routes'][0]['legs'][0]['steps']) * 2)

safety_score = calculate_safety_score(route_data)
print(f"Route Safety Score: {safety_score}")


